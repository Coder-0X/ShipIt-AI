# ==========================================
# ShipIt AI Enterprise Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for 4-Stage Reasoning Pipeline)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Webhook & API Integration
# Webhook Secret configured in your GitHub Repo -> Settings -> Webhooks
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Optional GitHub Personal Access Token (PAT) for fetching private PR diffs & posting PR review comments
GITHUB_TOKEN=ghp_your_github_token_here

# 3. Atlassian Jira Cloud Integration
# Base URL of your Atlassian instance (e.g. https://yourcompany.atlassian.net)
JIRA_HOST=https://yourcompany.atlassian.net
# Jira user email with API access
JIRA_EMAIL=developer@yourcompany.com
# Jira API Token generated at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
# Optional: Default Jira Project Key (e.g. PROJ)
DEFAULT_JIRA_PROJECT=PROJ

# 4. Slack Block-Kit Integration
# Incoming Webhook URL configured in Slack App Directory / Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_SECRET_TOKEN


# 5. Supabase Audit Ledger & Multi-Tenant Core
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (bypasses RLS for secure server-side webhook audit logging)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Default Organization ID for audit attribution
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000000

# 6. Stripe Billing (Optional for SaaS tiers)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
